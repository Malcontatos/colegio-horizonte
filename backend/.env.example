# PostgreSQL. Em produção, use a URL do seu provedor (Neon, Supabase, RDS etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/escola?schema=public"

# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave-por-uma-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=15
